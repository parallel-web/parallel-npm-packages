{
  "name": "@parallel-web/tanstack-ai",
  "version": "0.1.0-rc.0",
  "description": "Parallel Search tool for TanStack AI",
  "author": "Parallel Web",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tanstack",
    "ai",
    "parallel",
    "search",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallel-web/parallel-npm-packages.git",
    "directory": "packages/tanstack-ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "parallel-web": "^1.3.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@tanstack/ai": "^0.63.0"
  },
  "devDependencies": {
    "@tanstack/ai": "0.63.0"
  }
}
